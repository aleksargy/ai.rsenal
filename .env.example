# Copy to .env and fill in. Never commit .env.
# In GitHub Actions these become repository secrets.

# --- Required -----------------------------------------------------------------

# Your FPL team id. Find it in the URL when viewing your points:
# https://fantasy.premierleague.com/entry/<THIS_NUMBER>/event/1
FPL_TEAM_ID=

# --- Authenticated reads and all writes ---------------------------------------

# There is no scriptable FPL login: `users.premierleague.com` no longer resolves,
# and `account.premierleague.com` returns 403 to any non-browser client. A
# session must be harvested from a real browser and replayed.
#
# Generate with `arsenal auth login`, which opens a browser, waits for you to log
# in, and saves the session. Then `arsenal auth export` prints the value below.
#
# Accepts either a flat cookie map or a full Playwright storage_state:
#   {"pl_profile": "...", "sessionid": "..."}
#
# Expect this to expire every few weeks. When it does, the agent degrades to
# advisory mode and tells you — it does not silently stop working.
FPL_SESSION_JSON=

# --- Research agents ----------------------------------------------------------

ANTHROPIC_API_KEY=

# --- Notifications ------------------------------------------------------------

# Create a bot via @BotFather on Telegram; it gives you the token.
# Get your chat id by messaging the bot then opening:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional sources ---------------------------------------------------------
# Each missing key disables one adapter. The pipeline degrades rather than
# failing, so you can start with none of these.

# Google Cloud console -> enable YouTube Data API v3 -> create an API key
YOUTUBE_API_KEY=

# https://www.reddit.com/prefs/apps -> create a "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
