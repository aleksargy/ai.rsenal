# Copy to .env and fill in. Never commit .env.
# In GitHub Actions these become repository secrets.

# --- Required -----------------------------------------------------------------

# Your FPL team id. Find it in the URL when viewing your points:
# https://fantasy.premierleague.com/entry/<THIS_NUMBER>/event/1
FPL_TEAM_ID=

# --- Authenticated reads and all writes ---------------------------------------

# FPL authenticates with an OIDC bearer token, NOT session cookies. Replaying
# cookies returns 403; `Authorization: Bearer <access_token>` works. Every guide
# and library documenting pl_profile/sessionid is out of date.
#
# You do not fill this in by hand. Run:
#
#   1. Close every window of a Chromium browser, then restart it with:
#        --remote-debugging-port=9222
#   2. Log into FPL and open My Team (localStorage is only readable from an
#      open page on the origin).
#   3. uv run arsenal auth attach
#
# That writes this key for you, including the refresh token. Access tokens last
# one hour; the refresh token mints new ones server-side with no browser, so
# capture is a one-time step rather than a per-run one.
#
# Verify with `arsenal auth check`, and test the refresh path once with
# `arsenal auth refresh --force`.
FPL_SESSION_JSON=

# --- Research agents ----------------------------------------------------------

# A model key is needed to read press conferences and community posts. Without
# one the agent still runs on Tier 1 data (official injuries, suspensions,
# set-piece duty) — it just cannot read prose.
#
# Either provider works; set whichever you have.

# Paid, but small: ~$0.14-$0.71 per research run depending on the model.
# https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Free tier through Google AI Studio, with limits that fit a run comfortably.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Notifications ------------------------------------------------------------

# Create a bot via @BotFather on Telegram; it gives you the token.
# Get your chat id by messaging the bot then opening:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional sources ---------------------------------------------------------
# Each missing key disables one adapter. The pipeline degrades rather than
# failing, so you can start with none of these.

# Google Cloud console -> enable YouTube Data API v3 -> create an API key
YOUTUBE_API_KEY=

# https://www.reddit.com/prefs/apps -> create a "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
